{
  "name": "autoclipper-download-extension",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AutoClipper Video Downloader — Chrome extension to download videos from Instagram, TikTok, Reddit, X and more.",
  "homepage": "https://autoclipper.live",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "lint:fix": "eslint src tests --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"tests/**/*.ts\" \"*.{json,md}\"",
    "icons": "node scripts/icons.mjs",
    "zip": "npm run build && cd dist && zip -r ../autoclipper-download-extension.zip ."
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/chrome": "^0.0.326",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^10.1.0",
    "prettier": "^3.5.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
